{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anarlog Platform",
  "mainBinaryName": "anarlog-platform",
  "identifier": "com.stillerman.anarlog",
  "bundle": {
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "anarlog",
          "hyprnote"
        ]
      }
    }
  }
}
